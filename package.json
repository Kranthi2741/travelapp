{
  "name": "delusional-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace=delusional-diary-api\" \"vite --host 0.0.0.0\"",
    "dev:api": "npm run dev --workspace=delusional-diary-api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run start --workspace=delusional-diary-api"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.22.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "typescript": "~5.7.2",
    "vardhan-maps": "^0.6.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2"
  }
}
